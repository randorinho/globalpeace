{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpai-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],

  // The Worker owns the whole zone: static frontend assets at /*,
  // API gateway logic at /api/* (assets are checked first; misses fall
  // through to the fetch handler).
  "routes": [
    { "pattern": "globalpeace.ai/*", "zone_name": "globalpeace.ai" }
  ],

  "assets": {
    "directory": "../../frontend/dist",
    "not_found_handling": "single-page-application",
    // The asset layer's SPA fallback only catches browser navigations
    // (Sec-Fetch-Mode: navigate); crawlers hitting the sitemap's canonical
    // path urls (/about, /country/SD) fall through to the fetch handler,
    // which serves the shell through this binding.
    "binding": "ASSETS"
  },

  // Dark-origin phase 1 (docs/DARK_ORIGIN.md): public GET payloads are
  // served from snapshots the pipeline publishes (pipelines/publish), with
  // origin fallback on miss until phase 3 removes the proxy entirely.
  "r2_buckets": [
    { "binding": "SNAPSHOTS", "bucket_name": "gpai-public" }
  ],

  // Dark-origin phase 2: public contributions buffer at the edge, drained
  // by the origin during pipeline windows (schema/pending_contributions.sql).
  "d1_databases": [
    {
      "binding": "PENDING",
      "database_name": "gpai-edge",
      "database_id": "21e53c0b-2d94-470f-8a1d-6b4f2b0280f3"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Secrets — set via `wrangler secret put <NAME>`, never in this file:
  //   GATEWAY_SHARED_SECRET   must match GPAI_GATEWAY_SHARED_SECRET at the
  //                           origin; authenticates the origin's outbound
  //                           drain calls to /api/internal/*
  "vars": {}
}
